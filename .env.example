# Subpath when hosting under a path (default "/")
# VITE_BASE_PATH=/

# Branding / environment labels
VITE_SITE_TITLE=PeopleSpaceAM Platform Docs
VITE_SITE_SUBTITLE=Contracts, explorers, and integration references
VITE_SITE_ENVIRONMENT=Production

# REST base URL used by Scalar "Try it"
VITE_MINIAPP_API_BASE=https://example.invalid

# GraphQL endpoint shown in the docs
VITE_GRAPHQL_HTTP_URL=https://example.invalid/miniapp/graphql/v1

# Optional protected grpcui link
VITE_GRPCUI_URL=https://example.invalid/grpcui

# Shared MCP endpoint
VITE_MCP_SERVER_URL=https://example.invalid/mcp

# Backwards-compatible legacy variables still accepted:
# VITE_MINIAPP_API_TEST_BASE=...
# VITE_GRPCUI_TEST_URL=...
