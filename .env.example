# Subpath when hosting under a path (default "/")
# VITE_BASE_PATH=/

# "Try it" / docs copy: public test base for the Telegram Mini App HTTP API (no trailing slash)
VITE_MINIAPP_API_TEST_BASE=https://example.invalid

# Optional: full URL to a self-hosted GraphiQL (or similar) that points at test GraphQL BFF
VITE_GRAPHIQL_TEST_URL=https://example.invalid/graphiql

# Optional: operator link to grpcui against test (often VPN / SSO protected)
VITE_GRPCUI_TEST_URL=https://example.invalid/grpcui
